ORIGIN="http://localhost:4004"

# Extension registry signing (Ed25519). Never commit the private key.
# Default file (mode 600, outside the repo):
#   ~/.config/menzies/extension-signing/menzies-extensions-ed25519-1.key
# MENZIES_EXTENSION_SIGNING_KEY_FILE=/absolute/path/to/key
# MENZIES_EXTENSION_SIGNING_KEY=<base64 of the raw 32-byte seed>
# Generate once: npm run extensions:generate-key
# Publish: npm run extensions:build
# See docs/extension-registry.md.

# Public npm: @menzies-mariesta-com/menzies-design-wash-ui installs without NODE_AUTH_TOKEN.
